# Copy this file to home_assistant_email.config and replace every value.
# Keep home_assistant_email.config private; it contains command secrets.
# The sender is the Gmail account authorized through credentials.json and token.json.
to_email=your-home-assistant-command-inbox@example.com
on_subject=GAUTO_ON_replace-with-your-random-secret
off_subject=GAUTO_OFF_replace-with-your-random-secret
